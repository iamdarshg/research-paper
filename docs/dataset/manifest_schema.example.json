      "engine_count_min": 1,
      "engine_count_max": 1,
      "payload_mass_min_g": 400,
      "payload_mass_max_g": 900,
      "takeoff_distance_min_m": 90,
      "takeoff_distance_max_m": 180,
      "wall_thickness_min_mm": 1,
      "wall_thickness_max_mm": 2,
