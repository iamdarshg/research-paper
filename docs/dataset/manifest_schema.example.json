{
  "schema_name": "grounded_aircraft_manifest_record",
  "schema_version": 1,
  "validation_levels": ["basic", "claim-bearing"],
  "required_record_fields": [
    "geometry_path_or_stl_path",
    "split",
    "source_id",
    "geometry_provenance",
    "preprocessing_version",
    "units",
    "design_family",
    "design_spec"
  ],
  "allowed_splits": ["holdout", "test", "train", "val", "validation"],
  "required_design_spec_fields": [
    "target_speed_mps",
    "wingspan_limit_m",
    "thrust_to_weight_min",
    "turn_rate_min_deg_s",
    "required_static_thrust_n",
    "engine_diameter_mm",
    "engine_length_mm",
    "engine_count_min",
    "engine_count_max",
    "payload_mass_min_g",
    "payload_mass_max_g",
    "takeoff_distance_min_m",
    "takeoff_distance_max_m",
    "wall_thickness_min_mm",
    "wall_thickness_max_mm",
    "part_count_min",
    "part_count_max",
    "manufacturing_method"
  ],
  "optional_response_metrics_for_condition_benchmark": [
    "payload_response",
    "thrust_response",
    "maneuverability_response",
    "structural_response"
  ],
